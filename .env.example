# ─────────────────────────────────────────────────────────────
# ORVIX (Earth Intelligence Systems) Environment Configuration
# Copy this file to .env or backend/.env and supply credentials.
# ─────────────────────────────────────────────────────────────

# NASA EONET API Key (Optional for development)
# Public endpoints work with "DEMO_KEY" (rate-limited).
# Obtain a free key at: https://api.nasa.gov/
NASA_API_KEY=DEMO_KEY

# Copernicus Data Space Ecosystem (CDSE) / Sentinel Hub Credentials (Required for live imagery)
# Register OAuth clients at: https://shapps.dataspace.copernicus.eu/dashboard/#/account/settings
SENTINEL_CLIENT_ID=your_cdse_client_id_here
SENTINEL_CLIENT_SECRET=your_cdse_client_secret_here

# MongoDB Persistence Layer (Optional — falls back gracefully to in-memory/disk persistence)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=orvix


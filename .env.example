# ─────────────────────────────────────────────────────────────
# ORVIX (Earth Intelligence Systems) Environment Configuration
# Copy this file to .env or backend/.env and supply credentials.
# ─────────────────────────────────────────────────────────────

# NASA EONET API Key (Optional for development)
# Public endpoints work with "DEMO_KEY" (rate-limited).
# Obtain a free key at: https://api.nasa.gov/
NASA_API_KEY=DEMO_KEY

# Earth Search STAC by Element 84 (AWS Open Data)
# Free and public — no API key or OAuth credentials required!
# Endpoint: https://earth-search.aws.element84.com/v1
# Collections: sentinel-2-l2a, landsat-c2-l2

# Copernicus Data Space Ecosystem (CDSE) / Sentinel Hub (Optional / Legacy)
# The platform uses Earth Search STAC for active satellite data acquisition.
# CDSE credentials are only needed if legacy Copernicus endpoints are explicitly targeted.
SENTINEL_CLIENT_ID=your_cdse_client_id_here
SENTINEL_CLIENT_SECRET=your_cdse_client_secret_here

# MongoDB Persistence Layer (Optional — falls back gracefully to local disk / JSON persistence)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=orvix
